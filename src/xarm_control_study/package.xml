<?xml version="1.0"?>
<package format="3">
  <name>xarm_control_study</name>
  <version>0.1.0</version>
  <description>Single xArm7 Gazebo joint control learning example.</description>
  <maintainer email="rico@example.com">rico</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- 직접 작성하는 node에는 SDK나 실제 robot driver가 필요하지 않습니다. -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xarm_gazebo</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
